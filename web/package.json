{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && cp build/404.html build/index.html",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@tiptap/core": "^3.35.0",
		"@tiptap/extension-highlight": "^3.35.0",
		"@tiptap/markdown": "^3.35.0",
		"@tiptap/pm": "^3.35.0",
		"@tiptap/starter-kit": "^3.35.0",
		"@tiptap/suggestion": "^3.35.0",
		"svelte-dnd-action": "^0.9.81"
	}
}
