{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // exigido pelo OAuth do conector do Claude (busca de documentos de cliente só em endereços públicos)
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pyle-db",
      "database_id": "4a10b35d-af05-4dbb-8cb2-969f8601d752",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "pyle-files" }],
  // tokens do conector do Claude (OAuth)
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "e4eadb3a21864a8aa6e1f39e5fb7611c" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://lucaserbano.github.io,http://localhost:5173",
    "BACKUP_REPO": "lucaserbano/pyle-dados",
    "FILES_QUOTA_BYTES": "5368709120",
    "SITE_URL": "https://lucaserbano.github.io/Portal"
  },
  // Backup diário em .md às 06:00 UTC (03:00 em Brasília)
  "triggers": { "crons": ["0 6 * * *"] }
  // Segredos (wrangler secret put): PASSWORD_HASH, GITHUB_TOKEN, FILE_KEY, ICLOUD_EMAIL, ICLOUD_APP_PASSWORD
}
